{
  "name": "notes-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --ios",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup-hooks": "chmod +x scripts/setup-hooks.sh .githooks/pre-commit && ./scripts/setup-hooks.sh",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "check-all": "npm run format:check && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@10play/tentap-editor": "^0.7.4",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.11",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.18.3",
    "expo": "^54.0.36",
    "expo-haptics": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "prop-types": "^15.8.1",
    "react": "^19.2.7",
    "react-native": "^0.86.0",
    "react-native-controlled-mentions": "^3.1.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.2",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.26.2",
    "react-native-webview": "13.17.0",
    "react-native-worklets": "0.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@react-native/eslint-config": "^0.86.0",
    "@types/react": "~19.2.17",
    "babel-preset-expo": "^54.0.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "private": true
